# Fastflow buyer site (Flask) — copy to .env and adjust. No real secrets here.

# Postgres connection (REQUIRED). Use the RLS-restricted fastflow_app role, NOT
# fastflow_owner. libpq URI form, no spaces. Tenant isolation is enforced by
# Postgres RLS keyed on app.site_id, which the app sets per request from host.
DATABASE_URL=postgresql://fastflow_app:APP_PASSWORD@localhost:5432/fastflow

# Flask session signing key. REQUIRED in production; dev uses an ephemeral key.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Supplier portal (Next.js) the buyer site reads its catalog from.
PORTAL_API_URL=http://localhost:3000
# Portal URL used for the "Supplier Portal" / "List your company" buttons.
PORTAL_URL=http://localhost:3000
# Bridge HTTP timeout in seconds.
PORTAL_TIMEOUT=2.5

# Contact-form staff notifications. "console" (default) just logs; "smtp"
# delivers real mail. Settings below are for Namecheap Private Email:
#   host mail.privateemail.com, port 587 (STARTTLS), username = full address.
# From must be the authenticated mailbox; Reply-To is set to the buyer per send.
# CONTACT_EMAIL_FROM/TO default to SMTP_USER if left blank.
CONTACT_EMAIL_MODE=console
SMTP_HOST=mail.privateemail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=

# Production toggles (leave unset for local development).
# PRODUCTION=1     # enables secure cookies + requires SECRET_KEY
# FLASK_DEBUG=1    # dev-only debug mode
# BIND_ALL=1       # bind 0.0.0.0 instead of 127.0.0.1
