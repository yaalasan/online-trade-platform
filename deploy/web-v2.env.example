# Fastflow buyer site — production EnvironmentFile TEMPLATE.
# Install to /etc/fastflow/web-v2.env  (root:root, chmod 600). NEVER commit real
# values. Referenced by fastflow-web-v2.service.
#
# Fill the <...> placeholders from Part 2 (fresh DB password) and by carrying the
# existing session key / portal + SMTP settings across from the old app's env.

# fastflow_app DSN — the RLS-restricted role, NOT fastflow_owner. Password is the
# freshly generated one from migration/01_setup.sql on the server (do NOT reuse
# the local dev password).
DATABASE_URL=postgresql://fastflow_app:<FRESH_APP_PASSWORD>@localhost:5432/fastflow

# Canonical production switch: enables secure cookies, HSTS/ProxyFix, and the
# unknown-Host 404 (no dev fallback to site 1).
APP_ENV=production

# Flask session signing key — CARRY ACROSS the existing one from the old app so
# current sessions/behaviour are preserved. If none exists, generate:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<CARRY_ACROSS_OR_GENERATE>

# Contact-form email (Namecheap Private Email, STARTTLS on 587).
CONTACT_EMAIL_MODE=smtp
SMTP_HOST=mail.privateemail.com
SMTP_PORT=587
SMTP_USER=sales@fastflow.global
SMTP_PASSWORD=<MAILBOX_PASSWORD>
CONTACT_EMAIL_FROM=sales@fastflow.global
CONTACT_EMAIL_TO=sales@fastflow.global

# Supplier portal bridge — carry across from the old app's env.
PORTAL_API_URL=http://localhost:3000
PORTAL_URL=https://portal.fastflow.global
PORTAL_TIMEOUT=2.5
